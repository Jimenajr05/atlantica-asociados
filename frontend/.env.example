# URL del Backend API (para Server-Side Rendering y Rewrites)
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# URL base del sitio web público
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Teléfono y WhatsApp de contacto directo (Costa Rica)
NEXT_PUBLIC_WHATSAPP_NUMBER=50660024545
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Hola, necesito información y asesoría sobre un trámite ante una institución."
NEXT_PUBLIC_CONTACT_EMAIL=[CORREO_TEMPORAL]

# Supabase - Acceso público cliente (Opcional - para autenticación en panel de admin)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
