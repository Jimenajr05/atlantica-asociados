# Puerto del servidor backend
PORT=5000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
# Proxy Next.js local. En despliegue, indicar únicamente los proxies conocidos.
TRUST_PROXY=loopback

# Supabase: obligatorio en producción; almacenamiento local solo en desarrollo/pruebas.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada
SUPABASE_STORAGE_BUCKET=case-documents

# Configuración SMTP para Notificaciones de Casos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=infoatlantica.asociados@gmail.com
SMTP_PASS=tu-contraseña-o-app-password
SMTP_FROM="Atlántica & Asociados <infoatlantica.asociados@gmail.com>"
NOTIFICATION_EMAIL_TO=infoatlantica.asociados@gmail.com

# Límite de consultas por IP en 1 hora
RATE_LIMIT_MAX_PER_HOUR=5

# Citas: true registra los mensajes sin enviarlos. Usar false en producción.
NOTIFICATIONS_TEST_MODE=true
# Solo desarrollo. En producción la cola vive en Supabase y Vercel Cron la procesa.
NOTIFICATION_STORE_PATH=data/appointment-notifications.json
# Configurar en Vercel con un secreto aleatorio de al menos 32 caracteres.
CRON_SECRET=
APPOINTMENT_CONTACT="infoatlantica.asociados@gmail.com / +506 6002-4545"
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=es
