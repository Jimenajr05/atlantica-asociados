# Puerto del servidor backend
PORT=5000
FRONTEND_URL=http://localhost:3000

# Supabase (Opcional - Si no se configura, usará automáticamente el almacenamiento local data/cases.json y data/posts.json)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-privada
SUPABASE_STORAGE_BUCKET=case-documents

# Configuración SMTP para Notificaciones de Casos
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-o-app-password
SMTP_FROM="Atlántica & Asociados <notificaciones@atlanticayasociados.com>"
NOTIFICATION_EMAIL_TO=notificaciones@atlanticayasociados.com

# Límite de consultas por IP en 1 hora
RATE_LIMIT_MAX_PER_HOUR=5
