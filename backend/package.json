{
  "name": "atlantica-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "npm run build && tsx --test tests/*.test.ts && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "marked": "^18.0.14",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.13",
    "sanitize-html": "^2.17.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.5",
    "@types/sanitize-html": "^2.16.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
